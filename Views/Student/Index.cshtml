@{
    ViewData["Title"] = "Hello World";
}

<div class="container">

    <!-- Tiêu đề -->
    <div class="text-center mb-4">
        <h1 class="display-5 fw-bold text-primary">
            Hello World
        </h1>

        <p class="lead">
            Đây là trang ASP.NET Core MVC đầu tiên của tôi
        </p>
    </div>


    <!-- CARD -->
    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                Demo Bootstrap
            </h4>
        </div>

        <div class="card-body">

            <h5 class="card-title">
                Xin chào!
            </h5>

            <p class="card-text">
                Tôi đang học ASP.NET Core MVC tại HUMG.
            </p>

            <hr />

            <h5>Các thành phần MVC đang học:</h5>

            <!-- Danh sách -->
            <ul class="list-group mb-4">

                <li class="list-group-item">
                    Controller
                </li>

                <li class="list-group-item">
                    View
                </li>

                <li class="list-group-item">
                    Model
                </li>

                <li class="list-group-item">
                    Bootstrap
                </li>

            </ul>


            <!-- Button -->
            <a class="btn btn-primary"
               asp-controller="Home"
               asp-action="Index">

                Về trang chủ

            </a>

        </div>

    </div>

</div>